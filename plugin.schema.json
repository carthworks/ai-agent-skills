{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/carthworks/ai-agent-skills/blob/main/plugin.schema.json",
  "title": "Agentic Plugin Bundle Schema",
  "description": "Validates plugin.json files for multi-component bundles in the ai-agent-skills repository.",
  "type": "object",
  "required": ["name", "category", "description", "components", "metadata"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 64,
      "description": "Unique plugin identifier in kebab-case."
    },
    "category": {
      "type": "string",
      "enum": ["security", "launch", "quality", "fullstack", "devops", "general"],
      "description": "Domain of the plugin bundle."
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1000,
      "description": "Summary of what capabilities this bundled stack provides."
    },
    "license": {
      "type": "string",
      "enum": [
        "Apache-2.0",
        "MIT",
        "BSD-2-Clause",
        "BSD-3-Clause",
        "ISC",
        "GPL-3.0",
        "MPL-2.0",
        "CC-BY-4.0",
        "CC0-1.0"
      ]
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skills": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Referenced skill paths or identifiers included in the bundle."
        },
        "mcps": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Referenced MCP server paths or identifiers included in the bundle."
        },
        "agents": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Referenced subagent paths or identifiers included in the bundle."
        },
        "rules": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Referenced rule files included in the bundle."
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["version", "publisher"],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^v?[0-9]+(\\.[0-9]+)*(\\.[0-9]+)?$"
        },
        "publisher": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9-]{0,37}[a-zA-Z0-9])?$"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "maxItems": 10,
          "uniqueItems": true
        }
      }
    }
  }
}
